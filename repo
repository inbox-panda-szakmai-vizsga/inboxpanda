
#!/usr/bin/env bash

set -e
VENV_DIR="./cli/.venv"
if [ ! -d "$VENV_DIR" ]; then

    # 1. Check Python 3.13+
    if ! command -v python3 &> /dev/null; then
        echo "Error: Python 3 is not installed."
        exit 1
    fi

    PYTHON_VERSION=$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')

    if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 13) else 1)'; then
        echo "Error: Python 3.13 or above is required. Found: $PYTHON_VERSION"
        exit 1
    fi

    # 2. Check pip
    if ! python3 -m pip --version &> /dev/null; then
        echo "Error: pip is not installed."
        exit 1
    fi

    echo "Creating virtual environment..."
    python3 -m venv "$VENV_DIR"

    echo "Installing CLI dependencies..."
    "$VENV_DIR/bin/python" -m pip install -r ./cli/requirements.txt

fi
export FROM_CLI=1
# 4. Execute CLI, forwarding all arguments
exec "$VENV_DIR/bin/python" ./cli/ $0 "$@"
